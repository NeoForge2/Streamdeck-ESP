# Copy this file to "dashboard_config.yaml".
# dashboard_config.yaml is ignored by Git.
#
# You can edit this file manually to get started, but most settings can then
# be managed from the companion application's visual configuration interface.

connection:
  host: "192.168.1.XX"        # Stream Deck IP address
  port: 6053
  api_key: "REPLACE_WITH_THE_SAME_KEY_AS_THE_FIRMWARE"

# Legacy internal values kept for backward compatibility:
#   carre = square
#   rond  = round
shape: "carre"

# Optional Home Assistant connection.
#
# Used by "barre" and "texte" slots to display live entity states, and by
# "home_assistant" actions to call Home Assistant services.
home_assistant:
  url: ""
  token: ""

# One or more profiles.
#
# Each profile has its own 36-slot grid and 3 rotary encoders.
# The profile without a trigger is used as the default profile.
#
# Internal slot type values are intentionally kept unchanged for backward
# compatibility:
#   bouton = button
#   barre  = bar
#   texte  = text
#
# action.type:
#   none
#   keys
#   launch
#   url
#   media
#   home_assistant

profiles:
  - name: "Defaut"
    trigger: null

    slots:
      - { label: "Discord", icon: "mic", type: "bouton", visible: true,
          action: { type: "launch", target: "%LOCALAPPDATA%\\Discord\\Update.exe --processStart Discord.exe" } }

      - { label: "Browser", icon: "", type: "bouton", visible: true,
          action: { type: "launch", target: "chrome.exe" } }

      - { label: "Screenshot", icon: "", type: "bouton", visible: true,
          action: { type: "keys", target: ["ctrl", "shift", "s"] } }

      - { label: "Play / Pause", icon: "play_arrow", type: "bouton", visible: true,
          action: { type: "media", target: "play_pause" } }

      - { label: "Volume", icon: "volume_up", type: "barre", visible: true,
          ha_entity: "sensor.pc_volume" }

      - { label: "Room temperature", icon: "wb_sunny", type: "texte", visible: true,
          ha_entity: "sensor.room_temperature" }

      - { label: "Office light", icon: "lightbulb_outline", type: "bouton", visible: true,
          action: { type: "home_assistant", domain: "light", service: "toggle", entity_id: "light.office" } }

      - { label: "Slot 8", icon: "", type: "bouton", visible: true,
          action: { type: "none", target: "" } }

      - { label: "Slot 9", icon: "", type: "bouton", visible: true,
          action: { type: "none", target: "" } }

      - { label: "Slot 10", icon: "", type: "bouton", visible: true,
          action: { type: "none", target: "" } }

      - { label: "Slot 11", icon: "", type: "bouton", visible: true,
          action: { type: "none", target: "" } }

      - { label: "Slot 12", icon: "", type: "bouton", visible: true,
          action: { type: "none", target: "" } }

      - { label: "Slot 13", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 14", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 15", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 16", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 17", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 18", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 19", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 20", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 21", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 22", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 23", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 24", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 25", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 26", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 27", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 28", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 29", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 30", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 31", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 32", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 33", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 34", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 35", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

      - { label: "Slot 36", icon: "", type: "bouton", visible: false,
          action: { type: "none", target: "" } }

    encoders:
      - clockwise: { type: "media", target: "vol_up" }
        anticlockwise: { type: "media", target: "vol_down" }
        press: { type: "media", target: "mute" }

      - clockwise: { type: "none", target: "" }
        anticlockwise: { type: "none", target: "" }
        press: { type: "none", target: "" }

      - clockwise: { type: "none", target: "" }
        anticlockwise: { type: "none", target: "" }
        press: { type: "none", target: "" }

# Optional HTTP receiver allowing Home Assistant to trigger actions on the PC.
# Leave the token empty to disable it.
receiver:
  token: ""
  port: 8765
